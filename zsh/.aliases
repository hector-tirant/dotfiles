#aliases

# Navigation shortcuts
alias ..="cd .."
alias ...="cd ../.."
alias ll="ls -la"
alias zz="source ~/.zshrc"

# MongoDB shortcuts
alias mongos="ulimit -n 10000 && sudo mongod --config /usr/local/etc/mongod.conf --fork"
alias mongo_start="brew services start mongodb/brew/mongodb-community"
alias mongo_stop="brew services stop mongodb/brew/mongodb-community"

# VPN shortcuts
alias cisco='open -a "Cisco Secure Client"'
alias ciscokill='pkill -x "Cisco Secure Client"'
alias vpnc="cd /Users/hectorgb/workspaces/personal/vpn_scripts && sudo ./vpn_tirant -c hectorgb@tirant XKZAntQ9TtVm && cisco"
alias vpnd="cd /Users/hectorgb/workspaces/personal/vpn_scripts && sudo ./vpn_tirant -d && ciscokill"
alias vpns="cd /Users/hectorgb/workspaces/personal/vpn_scripts && sudo ./vpn_tirant -s"
alias vpnr="vpnd && vpnc"

# Work shortcuts
alias sesame="cd /Users/hectorgb/workspaces/personal/autosesame && python3 autocheck.py -m 10"
alias start="depende && vpnr && sesame"
alias rubo='docker compose exec app bundle exec rubocop $(git diff --name-only origin/master...HEAD --diff-filter=AM | grep "\.rb$")'
function ruboapi() {
    docker compose exec app bundle exec rubocop $(git diff --name-only origin/master...HEAD --diff-filter=AM | grep "\.rb$" | sed 's|^[^/]*/||' | xargs -I {} sh -c 'test -f "{}" && echo "{}"')
}

# Git shortcuts
alias g="git"
alias gs="git status"
alias gco="git checkout"
alias gl="git log"
alias gb="git branch"
alias gp="git push"
# remove branches
alias gd="git branch -D"
alias gbdel="git branch | sed '1!d' | xargs -I {} git branch -D {}"
function gbdn() {
    local branch_to_delete=$(git branch | sed "${1}!d" | xargs)
    git branch -D $branch_to_delete
}

#OPENSHIFT
alias oc-login-vlc="oc login https://api.ocp-vlc.tirant.net:6443 --username=tirant --password=trnt,47"
alias oc-login-cnt="oc login https://api.ocp-cnt.tirant.net:6443 --username=tirant --password=trnt,47"
alias oc-projects='oc project $(oc get projects -o custom-columns=PROJECT:.metadata.name | fzf)'
alias oc-shell='oc rsh $(oc get pods -o custom-columns=POD:.metadata.name | fzf)'
alias oc-logs='oc logs -f $(oc get pods -o custom-columns=POD:.metadata.name | fzf)'

